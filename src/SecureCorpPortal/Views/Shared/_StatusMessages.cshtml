@{
    var success = TempData[PortalControllerBase.SuccessMessageKey] as string;
    var error = TempData[PortalControllerBase.ErrorMessageKey] as string;
}
@if (!string.IsNullOrEmpty(success))
{
    <div class="alert alert-success" role="status" data-autodismiss>@success</div>
}
@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-error" role="alert">@error</div>
}
