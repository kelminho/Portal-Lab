@model UserDirectoryViewModel
@{
    ViewData["Title"] = "Diretório de usuários";
}
<div class="page-header">
    <div>
        <h1>Diretório de usuários</h1>
        <p class="muted">Consulta somente leitura (ADMIN e ANALYST).</p>
    </div>
    <form asp-controller="Users" asp-action="Index" method="get" class="search-inline" role="search">
        <input type="search" name="q" value="@Model.Query" maxlength="100" placeholder="Nome, usuário, e-mail ou departamento" aria-label="Buscar usuários" />
        <button type="submit" class="btn btn-primary">Filtrar</button>
    </form>
</div>

<section class="card">
    @if (Model.Users.Count == 0)
    {
        <p class="muted">Nenhum usuário encontrado.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Usuário</th>
                        <th>Nome</th>
                        <th>Departamento</th>
                        <th>Cargo</th>
                        <th>Papel</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Users)
                    {
                        <tr>
                            <td><a asp-controller="Users" asp-action="Details" asp-route-id="@u.Id">@u.UserName</a></td>
                            <td>@u.FullName</td>
                            <td>@(u.Department ?? "—")</td>
                            <td>@(u.JobTitle ?? "—")</td>
                            <td><span class="@DisplayHelpers.RoleCss(u.Role)">@u.Role</span></td>
                            <td>@(u.IsActive ? "Ativo" : "Inativo")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
