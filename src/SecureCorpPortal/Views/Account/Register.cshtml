@model RegisterRequest
@{
    ViewData["Title"] = "Cadastro";
}
<section class="auth-card card wide">
    <h1>Criar conta</h1>
    <p class="muted">
        Novas contas recebem o papel <strong>GUEST</strong> (acesso mínimo).
        Um administrador pode conceder mais permissões depois.
    </p>

    <form asp-controller="Account" asp-action="Register" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="grid-2">
            <div class="field">
                <label asp-for="UserName"></label>
                <input asp-for="UserName" autocomplete="username" autofocus />
                <span asp-validation-for="UserName" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="FullName"></label>
                <input asp-for="FullName" autocomplete="name" />
                <span asp-validation-for="FullName" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Department"></label>
                <input asp-for="Department" />
                <span asp-validation-for="Department" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="new-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>
        </div>

        <p class="hint">A senha deve ter 8+ caracteres, com letra maiúscula, minúscula, número e símbolo.</p>

        <button type="submit" class="btn btn-primary btn-block">Criar conta</button>
    </form>

    <p class="muted small center">
        Já possui conta? <a asp-controller="Account" asp-action="Login">Entrar</a>
    </p>
</section>
