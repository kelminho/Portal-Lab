@model IReadOnlyList<AdminUserDto>
@{
    ViewData["Title"] = "Gerenciar usuários";
    var currentUserId = User.GetUserId();
}
<p><a asp-controller="Admin" asp-action="Index">← Administração</a></p>

<div class="page-header">
    <div>
        <h1>Gerenciar usuários</h1>
        <p class="muted">Alterações de papel, status, exclusões e desbloqueios são registrados na auditoria.</p>
    </div>
</div>

<section class="card">
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Usuário</th>
                    <th>Nome</th>
                    <th>E-mail</th>
                    <th>Papel</th>
                    <th>Status</th>
                    <th>Falhas</th>
                    <th>Último login</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    var isSelf = u.Id == currentUserId;
                    <tr>
                        <td>@u.UserName @if (isSelf) { <span class="muted small">(você)</span> }</td>
                        <td>@u.FullName</td>
                        <td>@u.Email</td>
                        <td><span class="@DisplayHelpers.RoleCss(u.Role)">@u.Role</span></td>
                        <td>
                            @if (u.IsLockedOut)
                            {
                                <span class="badge sev-high">Bloqueado</span>
                            }
                            else if (!u.IsActive)
                            {
                                <span class="badge sev-medium">Inativo</span>
                            }
                            else
                            {
                                <span class="badge sev-info">Ativo</span>
                            }
                        </td>
                        <td>@u.AccessFailedCount</td>
                        <td class="nowrap">@DisplayHelpers.FormatDate(u.LastLoginAt)</td>
                        <td class="actions-cell">
                            <a class="btn btn-secondary btn-sm" asp-controller="Admin" asp-action="EditUser" asp-route-id="@u.Id">Editar</a>
                            @if (u.IsLockedOut)
                            {
                                <form asp-controller="Admin" asp-action="UnlockUser" asp-route-id="@u.Id" method="post" class="inline-form">
                                    <button type="submit" class="btn btn-secondary btn-sm">Desbloquear</button>
                                </form>
                            }
                            @if (!isSelf)
                            {
                                <form asp-controller="Admin" asp-action="DeleteUser" asp-route-id="@u.Id" method="post" class="inline-form"
                                      data-confirm="Excluir definitivamente o usuário @u.UserName?">
                                    <button type="submit" class="btn btn-danger btn-sm">Excluir</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
