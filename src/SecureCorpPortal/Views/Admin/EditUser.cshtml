@model AdminEditUserViewModel
@{
    ViewData["Title"] = "Editar usuário";
}
<p><a asp-controller="Admin" asp-action="Users">← Gerenciar usuários</a></p>

<section class="card narrow">
    <h1>Editar usuário <span class="muted">@Model.UserName</span></h1>

    <form asp-controller="Admin" asp-action="EditUser" asp-route-id="@Model.Id" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <input type="hidden" asp-for="UserName" />

        <div class="grid-2">
            <div class="field">
                <label asp-for="FullName"></label>
                <input asp-for="FullName" />
                <span asp-validation-for="FullName" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Email"></label>
                <input asp-for="Email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Department"></label>
                <input asp-for="Department" />
            </div>
            <div class="field">
                <label asp-for="JobTitle"></label>
                <input asp-for="JobTitle" />
            </div>
        </div>

        <fieldset class="fieldset">
            <legend>Privilégios</legend>
            @if (Model.IsSelf)
            {
                <p class="hint">Por segurança, você não pode alterar o próprio papel nem desativar a própria conta.</p>
            }
            <div class="grid-2">
                <div class="field">
                    <label asp-for="Role"></label>
                    @if (Model.IsSelf)
                    {
                        <select asp-for="Role" asp-items="Model.RoleOptions" disabled></select>
                    }
                    else
                    {
                        <select asp-for="Role" asp-items="Model.RoleOptions"></select>
                    }
                </div>
                <div class="field checkbox">
                    <label>
                        @if (Model.IsSelf)
                        {
                            <input asp-for="IsActive" disabled />
                        }
                        else
                        {
                            <input asp-for="IsActive" />
                        }
                        Conta ativa
                    </label>
                </div>
            </div>
        </fieldset>

        <button type="submit" class="btn btn-primary">Salvar alterações</button>
    </form>
</section>
