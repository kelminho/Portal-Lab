{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "AppLogging": {
    "Directory": "logs",
    "RetainedFileCountLimit": 14,
    "ConsoleFormat": "text"
  },
  "Storage": {
    "UploadDirectory": "data/uploads",
    "MaxFileSizeBytes": 5242880,
    "AllowedExtensions": [ ".pdf", ".txt", ".md", ".csv", ".png", ".jpg", ".jpeg", ".docx", ".xlsx" ]
  },
  "Seed": {
    "Enabled": false
  },
  "DataProtection": {
    "KeysDirectory": ""
  },
  "SecurityLab": {
    "Enabled": false,
    "EnabledModules": []
  },
  "AllowedHosts": "*"
}
