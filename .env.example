# Copie para ".env" para personalizar o docker-compose (opcional).
# Valores abaixo são padrões de LABORATÓRIO — não reutilize em ambientes reais.

POSTGRES_DB=securecorp
POSTGRES_USER=securecorp
POSTGRES_PASSWORD=securecorp_lab_only

# Porta local da aplicação
WEB_PORT=8080

# IP em que a porta é publicada. Padrão: só a própria máquina.
# No laboratório SOC, use o IP da interface da rede isolada (ex.: 192.168.56.10)
# para que a VM atacante alcance o portal e o source_ip nos logs seja o IP real.
BIND_IP=127.0.0.1

# Production | Development
ASPNETCORE_ENVIRONMENT=Production

# Cria usuários e documentos de demonstração na inicialização
SEED_DEMO_DATA=true
